/build/
parlant-agent-runtime/build/
parlant-agent-server/build/
dist/
*.so

# ================= Node =================
node_modules/
dist-ssr/
*.local

# ================= 运行时数据（会话/客户台账、embedding 缓存、评估缓存、日志）=================
# Parlant 引擎运行期生成，含用户会话数据；任意层级的 parlant-data/ 一律忽略
parlant-data/
# invest-advisor-demo 文件存储（客户/产品/订单/转人工），demo 缺失时自动按 SEED 重建
invest-advisor-demo/data/

# ================= 环境变量（含密钥，勿入库）=================
.env
.env.local
.env.*.local
# 保留占位符模板
!.env.example

# ================= 日志 =================
*.log
logs/
