  "glossary": {
    "glossary": [
      {
        "id": "term_risk_assessment",
        "name": "风险测评",
        "description": "评估客户风险承受能力的标准化流程，结果分为 C1（保守）至 C5（进取）五个等级。",
        "synonyms": [
          "风险评测",
          "风险承受能力评估",
          "C1",
          "C2",
          "C3",
          "C4",
          "C5"
        ],
        "usage_context": "客户问为什么要做测评时解释"
      },
      {
        "id": "term_suitability",
        "name": "适当性管理",
        "description": "监管要求：投资产品的风险等级不得高于客户的风险承受等级。",
        "synonyms": [
          "适当性",
          "投资者适当性"
        ],
        "usage_context": "拒绝超风险产品时的依据"
      },
      {
        "id": "term_asset_allocation",
        "name": "资产配置",
        "description": "将资金分散投资于不同资产类别以平衡风险与收益。",
        "synonyms": [
          "配置",
          "分散投资"
        ],
        "usage_context": "客户问怎么投时的核心框架"
      },
      {
        "id": "term_dca",
        "name": "定投",
        "description": "定期定额投资，平滑市场波动影响。",
        "synonyms": [
          "定期定额"
        ],
        "usage_context": "客户担心追高时的替代方案"
      },
      {
        "id": "term_max_drawdown",
        "name": "最大回撤",
        "description": "投资组合从最高点到最低点的最大亏损幅度。",
        "synonyms": [
          "回撤"
        ],
        "usage_context": "客户问最坏能亏多少时的量化指标"
      },
      {
        "id": "term_fund_advisor",
        "name": "基金投顾",
        "description": "持牌机构接受客户委托，代客户作出基金投资决策的服务。",
        "synonyms": [
          "投顾"
        ],
        "usage_context": "客户询问服务性质时的合规定义"
      }
    ]
  },
