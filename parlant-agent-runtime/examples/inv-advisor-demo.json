      {
        "id": "rsp_transfer_human",
        "template": "正在为您转接人工顾问，请稍候。",
        "title": "转人工",
        "signals": [],
        "usage_context": "转人工时的告知话术",
        "bound_to": "",
        "field_dependencies": [],
        "description": "",
        "tags": []
      }
    ]
  },
