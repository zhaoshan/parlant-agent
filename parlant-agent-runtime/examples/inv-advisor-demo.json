{
  "agent": {
    "id": "inv-advisor-demo",
    "name": "智能投顾 Demo",
    "description": "引导客户完成风险测评、产品推荐、风险揭示与交易确认的演示 Agent。数据全部模拟，不涉及真实交易；强调合规、可控、可解释。",
    "composition_mode": "fluid",
    "default_language": "zh-CN",
    "boundary": {
      "allowed": [],
      "prohibited": [
        "不得承诺任何投资收益率或保本保息",
        "不得推荐超出客户风险承受等级的产品",
        "不得提供具体个股买卖时点建议",
        "不得在客户未完成风险测评前推荐任何产品"
      ],
      "emergency_action": "如果客户表达强烈不满、涉及投诉或资金安全疑虑，立即转人工。"
    },
    "metadata": {},
    "preamble": [],
    "tags": [],
    "utterances": {
      "greeting": [],
      "preamble": [],
      "system_error_fallback": "抱歉，系统暂时繁忙，请稍后再试。",
      "timeout_fallback": "长时间未收到您的回复，如需继续服务请随时联系我。"
    },
    "version": "1.0.0"
  },
  "tools": {
    "tools": [
      {
        "id": "get_customer_profile",
        "name": "get_customer_profile",
        "source": "remote",
        "type": "http",
        "description": "获取客户画像（标签、是否已做风险测评、风险等级、是否VIP/专业投资者）。用于变量自动刷新与个性化服务判断。",
        "method": "GET",
        "url": "http://127.0.0.1:8300/customer/{customer_id}",
        "headers": {},
        "timeout_seconds": 10,
        "consequential": false,
        "input_schema": {
          "type": "object",
          "properties": {
            "customer_id": {
              "type": "string",
              "description": "客户ID（不填时自动使用当前会话客户）"
            }
          }
        }
      },
      {
        "id": "assess_risk",
        "name": "assess_risk",
        "source": "remote",
        "type": "http",
        "description": "提交风险测评：客户自报风险等级 C1（保守）/C2（稳健）/C3（平衡）/C4（成长）/C5（进取）。结果将写入客户档案，之后才能推荐产品。",
        "method": "POST",
        "url": "http://127.0.0.1:8300/risk/assess",
        "headers": {
          "Content-Type": "application/json"
        },
        "timeout_seconds": 10,
        "consequential": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "risk_level": {
              "type": "string",
              "enum": [
                "C1",
                "C2",
                "C3",
                "C4",
                "C5"
              ],
              "description": "客户自报风险等级"
            }
          },
          "required": [
            "risk_level"
          ]
        }
      },
      {
        "id": "get_products",
        "name": "get_products",
        "source": "remote",
        "type": "http",
        "description": "按风险等级查询适配产品列表（返回该等级及更低风险等级的产品）。",
        "method": "GET",
        "url": "http://127.0.0.1:8300/products",
        "headers": {},
        "timeout_seconds": 10,
        "consequential": false,
        "input_schema": {
          "type": "object",
          "properties": {
            "risk_level": {
              "type": "string",
              "enum": [
                "C1",
                "C2",
                "C3",
                "C4",
                "C5"
              ],
              "description": "客户风险等级"
            }
          },
          "required": [
            "risk_level"
          ]
        }
      },
      {
        "id": "get_market_data",
        "name": "get_market_data",
        "source": "remote",
        "type": "http",
        "description": "获取模拟行情（沪深300/纳斯达克/黄金/原油），返回当前价与涨跌幅。",
        "method": "GET",
        "url": "http://127.0.0.1:8300/market/data",
        "headers": {},
        "timeout_seconds": 10,
        "consequential": false,
        "input_schema": {
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "enum": [
                "沪深300",
                "纳斯达克",
                "黄金",
                "原油"
              ],
              "description": "行情标的"
            }
          }
        }
      },
      {
        "id": "place_order",
        "name": "place_order",
        "source": "remote",
        "type": "http",
        "description": "提交交易订单（产品ID + 金额），返回订单确认号。仅用于演示，不产生真实交易。",
        "method": "POST",
        "url": "http://127.0.0.1:8300/trade/order",
        "headers": {
          "Content-Type": "application/json"
        },
        "timeout_seconds": 10,
        "consequential": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "description": "产品ID"
            },
            "amount": {
              "type": "number",
              "description": "下单金额（元）"
            }
          },
          "required": [
            "product_id",
            "amount"
          ]
        }
      },
      {
        "id": "transfer_to_human",
        "name": "transfer_to_human",
        "source": "remote",
        "type": "http",
        "description": "转人工：返回人工客服工号与工单号。客户犹豫、不满、需要人工协助时使用。",
        "method": "POST",
        "url": "http://127.0.0.1:8300/human/transfer",
        "headers": {
          "Content-Type": "application/json"
        },
        "timeout_seconds": 10,
        "consequential": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "description": "转人工原因"
            }
          }
        }
      }
    ]
  },
