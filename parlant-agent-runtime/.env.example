# LLM（litellm 适配器：OpenAI 兼容的第三方/代理都走这里）
# 官方 OpenAI 则设 OPENAI_API_KEY 并把 main.py 的 nlp_service 换成 p.NLPServices.openai
# 注意：模型名必须带 litellm provider 前缀（如 openai/xxx），适配器不做拼接
LITELLM_PROVIDER_MODEL_NAME=openai/<chat-model>
LITELLM_PROVIDER_BASE_URL=https://<your-openai-compatible-endpoint>/v1
LITELLM_PROVIDER_API_KEY=sk-xxx
# embedding 模型同样要前缀；DIMENSIONS 必须等于该模型实际输出维度
# （Parlant 用它在 transient 向量库预分配矩阵宽度，不一致会 vstack 报错）
LITELLM_EMBEDDING_MODEL_NAME=openai/<embedding-model>
LITELLM_EMBEDDING_DIMENSIONS=1536

# 基础设施（对应 docker-compose.yml）【必需：缺失则启动报错】
# 阶段5 §5.7 会话状态外置：此 URI 同时作 session/customer/context_variable store 的共享 Mongo
# （各 store 独立库 parlant_sessions / parlant_customers / parlant_context_variables，多 pod 共享可接管同一会话）。
# ⚠️ 启用后既有 parlant-data/sessions.json 历史会话无法找回；生产如需独立会话集群用 SESSION_STORE_URI 覆盖。
MONGO_URI=mongodb://parlant:parlant-dev@localhost:27017/parlant?authSource=admin
# 可选：单独指定会话存储集群（空=复用 MONGO_URI）
SESSION_STORE_URI=
QDRANT_URL=http://localhost:6333

# langfuse 追踪（OTLP，无需 Langfuse SDK）
# 从 langfuse 后台只能拿到这三项；启动时 app.utils.observability.configure_langfuse_otel
# 会自动派生成 Parlant OpenTelemetryTracer 读取的 OTEL_*（endpoint/headers/protocol/timeout），
# 无需手算 base64。（这三项也可放在工作区根目录 .env —— Settings 会同时读根/项目两个 .env）
LANGFUSE_SECRET_KEY="sk-lf-xxx"
LANGFUSE_PUBLIC_KEY="pk-lf-xxx"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# 高级：也可不配这三项，直接显式给出 OTEL_*（会优先采用、跳过派生）
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic <base64(pk:sk)>,x-langfuse-ingestion-version=4

# 可选：示例内置工具 tavily_search
# TAVILY_API_KEY=tvly-...

# docker-compose 用（可选覆盖默认）
# MONGO_ROOT_USER=parlant
# MONGO_ROOT_PASSWORD=parlant-dev

# 服务间信任（doc16 §4.4）：/internal/* 校验的 X-Internal-Token，必须与 server .env 同值；
# 未配置则内部端点 fail-closed（拒绝），防止引擎控制面被直调。强随机串即可。
INTERNAL_TOKEN=

# 评估模型护栏（2026-11 评估管线加固）：on=评估缓存 miss 且当前 LITELLM_PROVIDER_MODEL_NAME
# 不在验证名单（agent_loader.PROVEN_EVAL_MODEL_MARKERS = SiliconFlow DeepSeek-V4-Flash）时
# 拒绝评估（blocked）+ 响亮告警。SDK 单 NLP 服务、plumbing 级"评估/对话双模型"不可行，
# 故 fail-closed：宁可不评也不让幻觉元数据落缓存（10-21 投顾卡节点 3 事故）。模拟对话
# 会经 server 查询 /internal/agents/{id}/eval-status 门禁，blocked/pending 时拒建会话。
# 缓存热（evaluation_cache 命中）时模型无关，对话模型可随意换。
EVAL_MODEL_GUARD=1
