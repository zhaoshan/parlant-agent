# 下游 runtime（parlant-agent-runtime，Parlant REST，仅内网）
RUNTIME_BASE_URL=http://127.0.0.1:8000
# RUNTIME_TIMEOUT=30.0

# 定义层（本服务独占写）【必需：缺失则启动报错】
MONGO_URI=mongodb://parlant:parlant-dev@localhost:27017/parlant?authSource=admin

# 用户会话台账（MySQL；阶段5 还将承载用户/登录/权限）【必需：缺失则启动报错】
MYSQL_URI=mysql+aiomysql://root:root123456@127.0.0.1:3306/parlant

# 服务端口（8080 常被本机 Docker 占用）
HOST=0.0.0.0
PORT=8081

# 跨域（阶段3 联调放开；生产收紧为 web 来源，逗号分隔）
CORS_ALLOW_ORIGINS=*

# 可观测（langfuse 数据读取；web 链路历史 tab 数据源）
# 未配置时 /api/traces/* 返回 503 提示，不阻断其它功能；与 runtime .env 同值
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
