# 下游 runtime（parlant-agent-runtime，Parlant REST，仅内网）
RUNTIME_BASE_URL=http://127.0.0.1:8000
# RUNTIME_TIMEOUT=30.0

# 定义层（本服务独占写）【必需：缺失则启动报错】
MONGO_URI=mongodb://parlant:parlant-dev@localhost:27017/parlant?authSource=admin

# 用户会话台账（MySQL；阶段5 还将承载用户/登录/权限）【必需：缺失则启动报错】
MYSQL_URI=mysql+aiomysql://root:root123456@127.0.0.1:3306/parlant

# 服务端口（8080 常被本机 Docker 占用）
HOST=0.0.0.0
PORT=8081

# 跨域（doc16 §4.3 收紧）：默认只放 web 开发来源，逗号分隔多来源（如未来网关形态）
CORS_ALLOW_ORIGINS=http://localhost:5173

# 可观测（langfuse 数据读取；web 链路历史 tab 数据源）
# 未配置时 /api/traces/* 返回 503 提示，不阻断其它功能；与 runtime .env 同值
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 鉴权（doc09 M1，2026-10-11 收敛两档）：AUTH_MODE=dev|gateway
#   dev=开发自动管理员（免令牌全权限，本地不减速，严禁生产）；gateway=接入 IAM（RS256+JWKS，唯一生产形态）
#   jwt（HS256 本地自签发）已淘汰：登录页收归 IAM hub（doc11 形态 B），无入口发/取 token
AUTH_MODE=dev
# iss/aud 校验（gateway 共用）：JWT_ISSUER 空=不校验 iss；JWT_AUDIENCE 与 IAM 签发令牌逐字符一致
JWT_ISSUER=
JWT_AUDIENCE=parlant-agent-server
# AUTH_MODE=gateway（E2E-1）：IAM JWKS 端点（如 https://unify-iam.example.com/.well-known/jwks.json），
# RS256 验签，私钥在 IAM、本服务仅持公钥可验不可伪造
JWT_JWKS_URL=
# 登录 BFF（POST /api/auth/login）的 IAM 令牌端点（如 https://unify-iam.example.com/api/v1/auth/token）；
# 空则该入口返回 503（本地账号登录不可用）
IAM_TOKEN_URL=
# 静默刷新（doc11 附录A）：IAM refresh 端点（POST /api/auth/refresh 转发）；空=由 IAM_TOKEN_URL 同源推导 /api/v1/auth/refresh
IAM_REFRESH_URL=
# 权限即时吊销（doc11 附录B / user-manual §6 方案①）：IAM 版本点查端点 + 服务间令牌
# 空 IAM_VERSIONS_TOKEN=关闭版本校验（不做即时吊销）；启用前需 IAM 侧 V10 生效 + 配 IAM_VERSIONS_SERVICE_TOKEN
IAM_VERSIONS_URL=
IAM_VERSIONS_TOKEN=
# SSO authorize 的 IAM 后端基址（doc11 §4.1）：web 经本服务 `GET /api/auth/sso/authorize` 302 跳转，
# 不直写 IAM URL。如 https://unify-iam.example.com
IAM_SSO_BASE=
# IAM 统一登录 hub（unify-iam-web）基址：gateway 模式 web 无 token 时跳它登录（GET /api/auth/mode 下发）；
# dev 模式不用。如 http://localhost:5174
IAM_HUB_BASE=
# SSE 令牌传输（doc09 §4.5）：query=短时 ?access_token（EventSource 兼容，默认）；cookie=HttpOnly（生产预留）
TOKEN_TRANSPORT=query
# runtime ↔ server 服务间信任（doc09 §4.4）：X-Internal-Token；未配置则不校验
# 必须与 runtime .env 的 INTERNAL_TOKEN **同值**；未配置则内部端点 fail-closed（拒绝），
# 说明性错误会暴露"两边不一致"。用强随机串，如 `python3 -c "import secrets;print(secrets.token_urlsafe(32))"`
INTERNAL_TOKEN=
